[Unit]
Description=water-controller: hourly check of liters per hour against the learned limits
After=postgresql.service

[Service]
Type=oneshot
User=wc_model
Group=wc_model
EnvironmentFile=/etc/wc-server/secrets.env
Environment=WC_MODEL_STATE=/var/lib/wc-model WC_PG_DSN=dbname=water
ExecStart=/opt/wc-server/model-venv/bin/python /opt/wc-server/model/score.py
ReadWritePaths=/var/lib/wc-model
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
