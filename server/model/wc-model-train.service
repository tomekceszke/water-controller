[Unit]
Description=water-controller: monthly retraining of the usage model and publishing of the learned limits
After=network-online.target postgresql.service mosquitto.service
Wants=network-online.target

[Service]
Type=oneshot
User=wc_model
Group=wc_model
EnvironmentFile=/etc/wc-server/secrets.env
Environment=WC_MODEL_STATE=/var/lib/wc-model WC_PG_DSN=dbname=water WC_MODEL_PYTHON=/opt/wc-server/model-venv/bin/python
ExecStart=/opt/wc-server/model/retrain.sh
StateDirectory=wc-model
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
