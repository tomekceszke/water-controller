# Copy to secrets.env (gitignored) and fill: openssl rand -base64 24 | tr -d '/+='
# MQTT_DEVICE_PASS must match MQTT_PASS in firmware/main/config/credentials.h
MQTT_DEVICE_PASS=
MQTT_INGEST_PASS=
PG_READ_PASS=
MQTT_MODEL_PASS=
# Optional: ntfy topic URL for server-side model alerts, e.g. https://ntfy.sh/<topic>
NTFY_URL=
